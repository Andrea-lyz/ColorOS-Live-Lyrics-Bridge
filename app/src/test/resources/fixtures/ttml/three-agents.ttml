<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata"><head><metadata><ttm:agent type="person" xml:id="v1"/><ttm:agent type="person" xml:id="v2"/><ttm:agent type="person" xml:id="v3"/><ttm:agent type="group" xml:id="v1000"/></metadata></head><body><div><p begin="1.000" end="2.000" ttm:agent="v2"><span begin="1.000" end="2.000">B first</span></p><p begin="3.000" end="4.000" ttm:agent="v1"><span begin="3.000" end="4.000">A second</span></p><p begin="5.000" end="6.000" ttm:agent="v3"><span begin="5.000" end="6.000">C third</span></p><p begin="7.000" end="8.000" ttm:agent="v1000"><span begin="7.000" end="8.000">All</span></p><p begin="9.000" end="10.000"><span begin="9.000" end="10.000">No agent</span></p><p begin="6.500" end="7.500" ttm:agent="v2"><span begin="6.500" end="7.500">Overlap out of order</span></p></div></body></tt>
